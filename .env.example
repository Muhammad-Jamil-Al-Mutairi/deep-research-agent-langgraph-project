# Copy this file to .env and fill in your values. Never commit .env.

# Required: your LLM provider API key
# paste your OpenRouter key here (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
MODEL_NAME=deepseek/deepseek-v4-flash
# Where HERMES writes its build artefacts (SQLite component DB, Chroma index)
# HERMES_DATA_DIR=.hermes
